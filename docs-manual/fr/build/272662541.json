ent": [{"type": "text", "text": "Saisie des demandes par lot", "marks": [{"type": "em"}]}]}]}, {"type": "orderedList", "attrs": {"order": 4}, "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cliquez sur l'onglet "}, {"type": "text", "text": "Demande d'examen", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Order", "marks": [{"type": "em"}]}, {"type": "text", "text": ") et sélectionnez "}, {"type": "text", "text": "Saisie d'ordonnances en lot", "marks": [{"type": "strong"}]}, {"type": "text", "text": ". "}]}]}]}, {"type": "mediaSingle", "attrs": {"layout": "wide", "width": 800, "widthType": "pixel"}, "content": [{"type": "media", "attrs": {"width": 1600, "type": "external", "url": "https://lh7-rt.googleusercontent.com/docsz/AD_4nXe_MK7usX1MeAMKHJHHk4r7-eI8IyR9Y1dleoI73lyKprtaaqa7qnXj3tpyOyYqW0BKMcwn9RRAeLGGhHAa-qWBEMmj60Am_BNJBEibKrHKAHFNQprPfecPUrar_bMAFtYWxne9iLMJp2bNp0fohB6bxPz0?key=RdnqcmhphzNc1dIKCApPKg", "height": 499}}, {"type": "caption", "content": [{"type": "text", "text": "Cliquer sur Saisie d'ordonnances en lot", "marks": [{"type": "em"}]}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Remarque : les champs marqués d'un astérisque (*) sont obligatoires."}]}, {"type": "orderedList", "attrs": {"order": 5}, "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dans la section de la demande, vérifiez la "}, {"type": "text", "text": "Date actuelle", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Current Date", "marks": [{"type": "em"}]}, {"type": "text", "text": ") au format jj/mm/aaaa et le champ "}, {"type": "text", "text": "Current Time ", "marks": [{"type": "strong"}]}, {"type": "text", "text": "au format hh:mm"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Vous pouvez modifier la "}, {"type": "te