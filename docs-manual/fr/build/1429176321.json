08aa98b3"}, "content": [{"type": "paragraph", "attrs": {"localId": "5eeecef9a010"}, "content": [{"type": "text", "text": "Le bouton Save & Next de l'étape Label & Store vous amène ici. Depuis le menu principal : Demande → Add Environmental Order → Revue assurance qualité ("}, {"type": "text", "text": "QA Review", "marks": [{"type": "em"}]}, {"type": "text", "text": ") (le menu utilise encore l'ancien nom)."}]}]}]}]}, {"type": "heading", "attrs": {"level": 2, "localId": "a85331b62229"}, "content": [{"type": "text", "text": "Étape 1 : Ouvrir la liste de contrôle de l'échantillon"}]}, {"type": "orderedList", "attrs": {"localId": "c698723f9590", "order": 1}, "content": [{"type": "listItem", "attrs": {"localId": "12f05c845c45"}, "content": [{"type": "paragraph", "attrs": {"localId": "b617ab5c0e77"}, "content": [{"type": "text", "text": "Acceptation à la réception", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Intake Acceptance", "marks": [{"type": "em"}]}, {"type": "text", "text": ") liste chaque échantillon avec son "}, {"type": "text", "text": "N° de laboratoire", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Lab #", "marks": [{"type": "em"}]}, {"type": "text", "text": "), son "}, {"type": "text", "text": "Type d'échantillon", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Sample type", "marks": [{"type": "em"}]}, {"type": "text", "text": "), son temps de "}, {"type": "text", "text": "Transit", "marks": [{"type": "strong"}]}, {"type": "text", "text": " et ses "}, {"type": "text", "text": "Conditions d'éligibilité", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Eligibility", "marks": [{"type": "em"}]}, {"type": "text", "text": ") (Pending tant que vous ne l'avez pas accepté). Sélectionnez un échantillon pour ouvrir sa liste de contrôle."}]}]}, {"type": "listItem", "attrs": {"localId": "0894a20baff7"}, "content": [{"type": "paragraph", "attrs": {"localId": "e1b1d02e002c"}, "content": [{"type": "text", "text": "L'en-tête de la liste de contrôle rappelle les heures de prélèvement et de réception ainsi que le temps de transit. Le transit est affiché à titre indicatif uniquement ; il n'entre dans aucune évaluation."}]}]}]}, {"type": "heading", "attrs": {"level": 2, "localId": "0c0a39ed5232"}, "content": [{"type": "text", "text": "Étape 2 : Remplir la liste de contrôle"}]}, {"type": "orderedList", "attrs": {"localId": "3b744a272e60", "order": 3}, "content": [{"type": "listItem", "attrs": {"localId": "94925582b641"}, "content": [{"type": "paragraph", "attrs": {"localId": "614ab9b5f947"}, "content": [{"type": "text", "text": "Pour chaque élément, choisissez "}, {"type": "text", "text": "Réussi", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Pass", "marks": [{"type": "em"}]}, {"type": "text", "text": "), "}, {"type": "text", "text": "Échec", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Fail", "marks": [{"type": "em"}]}, {"type": "text", "text": ") ou "}, {"type": "text", "text": "N/A", "marks": [{"type": "strong"}]}, {"type": "text", "text": ". La liste environnementale comporte six éléments : "}, {"type": "text", "text": "Container intact / undamaged", "marks": [{"type": "strong"}]}, {"type": "text", "text": ", "}, {"type": "text", "text": "Label legible and matches request", "marks": [{"type": "strong"}]}, {"type": "text", "text": ", "}, {"type": "text", "text": "Sample volume adequate", "marks": [{"type": "strong"}]}, {"type": "text", "text": ", "}, {"type": "text", "text": "Cold chain maintained", "marks": [{"type": "strong"}]}, {"type": "text", "text": ", "}, {"type": "text", "text": "Acceptable transit time / condition", "marks": [{"type": "strong"}]}, {"type": "text", "text": " et "}, {"type": "text", "text": "Required paperwork present and complete", "marks": [{"type": "s