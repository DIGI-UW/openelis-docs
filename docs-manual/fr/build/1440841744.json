 "em"}]}]}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Étape 2 : Générer"}]}, {"type": "orderedList", "attrs": {"order": 1}, "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cliquez sur "}, {"type": "text", "text": "Générer une version à imprimer", "marks": [{"type": "strong"}]}, {"type": "text", "text": " pour produire le rapport."}]}]}]}, {"type": "mediaSingle", "attrs": {"layout": "center", "width": 760, "widthType": "pixel"}, "content": [{"type": "media", "attrs": {"width": 1435, "alt": "générer une version à imprimer.png", "id": "35c4461e-a525-4ca8-a3dc-9e5b2c2f5053", "collection": "contentId-1440841744", "type": "file", "height": 586}}, {"type": "caption", "content": [{"type": "text", "text": "Générer une version à imprimer", "marks": [{"type": "em"}]}]}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Exportations de données"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Les exportations de données se trouvent dans le même menu Rapports et fonctionnent de la même manière : choisissez les paramètres (généralement une période), puis générez un fichier téléchargeable. Elles comprennent :"}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rapport CSV de routine", "marks": [{"type": "strong"}]}, {"type": "text", "text": " : une exportation CSV des données d'échantillons de routine."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Exportation générale", "marks": [{"type": "strong"}]}, {"type": "text", "text": " et "}, {"type": "text", "text": "Exportation des données de charge virale", "marks": [{"type": "strong"}]}, {"type": "text", "text": " : exportations de données d'études et de tendances."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rapport WHONET", "marks": [{"type": "strong"}]}, {"type": "text", "text": " : une exportation au format WHONET pour la surveillance de la RAM."}]}]}]}, {"type": "mediaSingle", "attrs": {"layout": "center", "width": 760, "widthType": "pixel"}, "content": [{"type": "media", "attrs": {"width": 1438, "alt": "exportation CSV des rapports agrégés.png", "id": "3906a4c8-9e73-44b9-9659-f9f519f0f262", "collection": "contentId-1440841744", "type": "file", "height": 588}}, {"type": "caption", "content": [{"type": "text", "text": "Exportation de données", "marks": [{"type": "em"}]}]}]}, {"type": "paragraph"}, {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Remarques"}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Les rapports et les exportations ont besoin de données réelles et validées pour produire des résultats utiles."}]}]}]}], "version": 1}}