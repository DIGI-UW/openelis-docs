{"en": "1438973960", "title": "Admin : Reconstruire l'index de recherche", "adf": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Guide pratique · Administrateurs", "marks": [{"type": "em"}]}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "En bref"}]}, {"type": "table", "attrs": {"layout": "default", "width": 760.0}, "content": [{"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Objectif"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reconstruire manuellement l'index de recherche qui alimente la recherche globale dans OpenELIS."}]}]}]}, {"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Résultat obtenu"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Un index de recherche entièrement reconstruit, à jour avec les données actuelles."}]}]}]}, {"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Qui s'en charge"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Administrateurs. L'accès dépend des droits de l'utilisateur et peut être configuré par votre administrateur."}]}]}]}, {"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Avant de commencer"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "tex