{"en": "1187840003", "title": "Admin : Gérer les comptes utilisateurs", "adf": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Guide pratique · Administrateurs (administration des comptes utilisateurs)", "marks": [{"type": "em"}]}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "En bref"}]}, {"type": "table", "attrs": {"layout": "default"}, "content": [{"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Objectif"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Créer et tenir à jour les comptes utilisateurs autorisés à se connecter à OpenELIS, et définir les rôles et droits d'accès de chaque utilisateur."}]}]}]}, {"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Résultat obtenu"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Un compte utilisateur actif doté des bons rôles globaux et rôles par unité de laboratoire."}]}]}]}, {"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Qui s'en charge"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Administrateurs (User Account Administrator ou Global Administrator). L'accès dépend des droits de l'utilisateur et peut être configuré par votre administrateur."}]}]}]}, {"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Avant de co