size": 2, "color": "#758195"}}]}, {"type": "caption", "attrs": {"localId": "cc683806ad1e"}, "content": [{"type": "text", "text": "Source terminologique", "marks": [{"type": "em"}]}]}]}, {"type": "orderedList", "attrs": {"localId": "abb168d36b24", "order": 2}, "content": [{"type": "listItem", "attrs": {"localId": "9f6a6d8c4afe"}, "content": [{"type": "paragraph", "attrs": {"localId": "dc40d54192e3"}, "content": [{"type": "text", "text": "Cliquez sur "}, {"type": "text", "text": "Ajouter un mappage", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Add mapping", "marks": [{"type": "em"}]}, {"type": "text", "text": "), puis sur "}, {"type": "text", "text": "Enregistrer", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Save", "marks": [{"type": "em"}]}, {"type": "text", "text": ")."}]}]}]}, {"type": "mediaSingle", "attrs": {"layout": "center", "width": 760, "widthType": "pixel"}, "content": [{"type": "media", "attrs": {"width": 1440, "alt": "10-editor-terminology 3.png", "id": "536cd70e-5268-4c34-a50d-67fc23df5394", "collection": "contentId-1432059909", "type": "file", "localId": "d26900348183", "height": 900}, "marks": [{"type": "border", "attrs": {"size": 2, "color": "#758195"}}]}, {"type": "caption", "attrs": {"localId": "993e796c2969"}, "content": [{"type": "text", "text": "Ajouter la correspondance et enregistrer", "marks": [{"type": "em"}]}]}]}, {"type": "paragraph", "attrs": {"localId": "00e1f553e527"}}, {"type": "paragraph", "attrs": {"localId": "9c35ecf77519"}, "content": [{"type": "text", "text": "Les "}, {"type": "text", "text": "types de relation", "marks": [{"type": "strong"}]}, {"type": "text", "text": " suivent les conventions standard de mise en correspondance terminologique et décrivent le lien entre cette analyse et le code standard auquel vous l'associez :"}]}, {"type": "bulletList", "attrs": {"localId": "46ad348c9620"}, "content": [{"type": "listItem", "attrs": {"localId": "34bffa845094"}, "content": [{"type": "paragraph", "attrs": {"localId": "aa6bb343a2ed"}, "content": [{"type": "text", "text": "Identique à", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Same as", "marks": [{"type": "em"}]}, {"type": "text", "text": ") : l'analyse et le code ont exactement la même signification. À utiliser pour une correspondance directe et exacte (le choix habituel)."}]}]}, {"type": "listItem", "attrs": {"localId": "4ce88e377fef"}, "content": [{"type": "paragraph", "attrs": {"localId": "332dc7ccd64d"}, "content": [{"type": "text", "text": "Plus large que", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Broader than", "marks": [{"type": "em"}]}, {"type": "text", "text": ") : l'analyse est un concept "}, {"type": "text", "text": "plus général", "marks": [{"type": "em"}]}, {"type": "text", "text": " que le code (le code est le terme le plus spécifique). Exemple : une analyse générique « Glucose » associée à un code spécifique « Glucose, fasting, serum »."}]}]}, {"type": "listItem", "attrs": {"localId": "25cec36738ca"}, "content": [{"type": "paragraph", "attrs": {"localId": "a51bedfc765f"}, "content": [{"type": "text", "text": "Plus étroit que", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Narrower than", "marks": [{"type": "em"}]}, {"type": "text", "text": ") : l'analyse est "}, {"type": "text", "text": "plus spécifique", "marks": [{"type": "em"}]}, {"type": "text", "text": " que le code (le code est le terme plus large, générique)."}]}]}]}, {"type": "paragraph", "attrs": {"localId": "b73844b303ea"}, "content": [{"text": "---", "type": "text"}]}], "version": 1}}