ntent": [{"type": "text", "text": "Cliquez sur "}, {"type": "text", "text": "Modifier", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Edit", "marks": [{"type": "em"}]}, {"type": "text", "text": ", icône d'engrenage) sur une ligne pour consulter ou définir les modèles de message de cette analyse."}]}]}]}, {"type": "mediaSingle", "attrs": {"layout": "center", "width": 760, "widthType": "pixel"}, "content": [{"type": "media", "attrs": {"width": 959, "alt": "email sms em edit.png", "id": "24c017e4-c793-4871-bf18-12c299ff1878", "collection": "contentId-1439072261", "type": "file", "height": 387}}, {"type": "caption", "content": [{"type": "text", "text": "Cliquer sur Modifier", "marks": [{"type": "em"}]}]}]}, {"type": "orderedList", "attrs": {"order": 2}, "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Effectuez vos modifications, puis cliquez sur "}, {"type": "text", "text": "Enregistrer", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Save", "marks": [{"type": "em"}]}, {"type": "text", "text": ") pour les appliquer, ou sur "}, {"type": "text", "text": "Quitter", "marks": [{"type": "strong"}]}, {"type": "text", "text": " ("}, {"type": "text", "text": "Exit", "marks": [{"type": "em"}]}, {"type": "text", "text": ") pour sortir sans enregistrer."}]}]}]}, {"type": "mediaSingle", "attrs": {"layout": "center", "width": 760, "widthType": "pixel"}, "content": [{"type": "media", "attrs": {"width": 958, "alt": "testing save.png", "id": "941e152b-bc7b-401c-b7dc-61b14978496a", "collection": "contentId-1439072261", "type": "file", "height": 1095}}, {"type": "caption", "content": [{"type": "text", "text": "Modifier et enregistrer", "marks": [{"type": "em"}]}]}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Description des champs"}]}, {"type": "table", "attrs": {"layout": "default", "width": 760.0}, "content": [{"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Colonne"}]}]}, {"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Remarques"}]}]}]}, {"type": "tableRow", "content": [{"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "E-mail du patient / SMS du patient"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Notifier le patient par e-mail ou par SMS."}]}]}]}, {"type": "tableRow", "content": [{"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "E-mail du prestataire / SMS du prestataire"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Notifier le prescripteur à l'origine de la demande par e-mail ou par SMS."}]}]}]}, {"type": "tableRow", "content": [{"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Modifier"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ouvrir le détail des modèles de l'analyse pour les canaux activés."}]}]}]}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "Remarques"}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Les notifications ne sont envoyées que si les canaux e-mail/SMS sous-jacents sont configurés dans Propriétés de l'application."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text",