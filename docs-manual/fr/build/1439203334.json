{"en": "1439203334", "title": "Admin : Gérer les prescripteurs", "adf": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Guide pratique · Administrateurs", "marks": [{"type": "em"}]}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"type": "text", "text": "En bref"}]}, {"type": "table", "attrs": {"layout": "default", "width": 760.0}, "content": [{"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Objectif"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Enregistrer et tenir à jour les prescripteurs, c'est-à-dire les cliniciens qui demandent des analyses, afin de pouvoir les sélectionner comme prescripteur d'une demande d'analyse."}]}]}]}, {"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Résultat obtenu"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Une fiche de prescripteur active, consultable et sélectionnable lors de la saisie des demandes."}]}]}]}, {"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Qui s'en charge"}]}]}, {"type": "tableCell", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Administrateurs. L'accès dépend des droits de l'utilisateur et peut être configuré par votre administrateur."}]}]}]}, {"type": "tableRow", "content": [{"type": "tableHeader", "attrs": {"colspan": 1, "rowspan": 1}, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Avant de commencer"}]}]}, {"type": "tableCell", "attrs": {